{
  "name": "lumen-rxd-wallet",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Lumen RXD Wallet — non-custodial Radiant (RXD) wallet for iOS",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync": "npm run build && cap sync ios",
    "ios": "cap open ios",
    "check:browser": "vite build -c vite.test.config.ts && node dist-test/browser-path-check.js",
    "check:smoke": "node scripts/smoke-browser.mjs",
    "check:phrase": "node scripts/check-phrase.mjs",
    "check:restore": "node scripts/e2e-restore.mjs",
    "check:connect": "node scripts/e2e-connect.mjs",
    "icons": "node scripts/build-ios-icons.mjs",
    "release": "node scripts/release-ios.mjs",
    "check:live": "node scripts/live-e2e.mjs",
    "probe": "node scripts/probe-servers.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@radiant-core/radiantjs": "^2.0.6",
    "@radiant-core/sdk": "^0.2.1",
    "buffer": "^6.0.3",
    "js-sha512": "^0.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxd-biometric-vault": "file:plugins/biometric-vault",
    "rxd-qr-scanner": "file:plugins/qr-scanner",
    "rxd-screen-security": "file:plugins/screen-security"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "ws": "^8.22.1"
  }
}
